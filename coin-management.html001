<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DS FOREVER | Points Management</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
if (!window.supabase) {
  document.write('<script src="https://unpkg.com/@supabase/supabase-js@2"><\/script>');
}
</script>
<style>
*{box-sizing:border-box}
body{margin:0;padding:16px;background:#080d18;color:#fff;font-family:Arial,sans-serif}
.wrap{max-width:760px;margin:20px auto;background:#101a2b;border:1px solid #354779;border-radius:16px;padding:18px}
h1,h2{color:#f5c451}
label{display:block;margin:14px 0 6px}
input,select,textarea{width:100%;padding:12px;border-radius:8px;border:1px solid #354779;background:#0b1220;color:white}
button{padding:12px 16px;margin:8px 6px 8px 0;border:0;border-radius:8px;background:#f5c451;color:#101827;font-weight:bold}
button.secondary{background:#263a59;color:#fff}
#status{color:#8fe6be;white-space:pre-wrap}
.entry{padding:12px;border-bottom:1px solid #354779}
.muted{color:#aab5c8;font-size:13px}
.hidden{display:none}
</style>
</head>
<body>
<div class="wrap" id="accessGate">
  <h1>DS FOREVER</h1>
  <p id="gateStatus">Loading secure admin session…</p>
  <button class="secondary" onclick="location.href='admin.html'">Back to Admin Login</button>
</div>

<div class="wrap hidden" id="app">
  <h1>Points Management</h1>
  <p class="muted">Non-cash, non-transferable points only. No wagering, staking, cash value, purchase or redemption.</p>
  <label>Find user by User ID / email / name</label>
  <input id="userSearch" placeholder="Type at least 2 characters">
  <button id="searchBtn">Search users</button>
  <div id="searchResults"></div>
  <hr style="border-color:#354779;margin:20px 0">
  <div id="selectedUser" class="hidden">
    <h2 id="userHeading">Selected user</h2>
    <label>Points amount</label>
    <input id="amount" type="number" min="1" step="1" placeholder="e.g. 100">
    <label>Action</label>
    <select id="action"><option value="add">Add points</option><option value="remove">Remove points</option></select>
    <label>Reason (required)</label>
    <textarea id="reason" rows="2" maxlength="240" placeholder="Reason for adjustment"></textarea>
    <button id="applyBtn">Save adjustment</button>
    <h2>Recent statement</h2>
    <div id="userLedger"></div>
  </div>
  <p id="status"></p>
  <button class="secondary" id="backBtn">Back to Admin</button>
  <button class="secondary" id="logoutBtn">Log out</button>
</div>

<script>
(() => {
  "use strict";
  const URL = "https://gplftdgweysvutrfkpni.supabase.co";
  const KEY = "sb_publishable_YSRfi0A-OZ2PpeJFOqsRNw_ee5z30VU";
  const STORAGE_KEY = "ds-forever-admin-auth";
  const $ = id => document.getElementById(id);
  let db;
  let selected = null;

  function showGate(message) {
    $("gateStatus").textContent = message;
  }
  function esc(v) {
    return String(v ?? "").replace(/[&<>"']/g, c => ({
      "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
    }[c]));
  }
  function showApp() {
    $("accessGate").classList.add("hidden");
    $("app").classList.remove("hidden");
  }
  function fail(message) {
    showGate("Points Management error: " + message);
    console.error("DS FOREVER Points Management:", message);
  }

  async function verifyAdmin(user) {
    if (!user?.id) throw new Error("Admin login session nahi mila. Admin Dashboard mein login karke dobara kholein.");
    const { data: profile, error } = await db
      .from("profiles")
      .select("id,role,full_name")
      .eq("id", user.id)
      .maybeSingle();
    if (error) throw new Error("Admin profile check failed: " + error.message);
    if (!profile) throw new Error("Is login ke liye profiles row nahi mili.");
    if (String(profile.role || "").toLowerCase() !== "admin") {
      throw new Error("Logged-in account ka role admin nahi hai.");
    }
    return profile;
  }

  async function initialize() {
    if (!window.supabase || typeof window.supabase.createClient !== "function") {
      throw new Error("Supabase library load nahi hui. Internet/CDN access check karein.");
    }

    showGate("Connecting to Supabase…");
    db = window.supabase.createClient(URL, KEY, {
      auth: {
        storageKey: STORAGE_KEY,
        persistSession: true,
        autoRefreshToken: true,
        detectSessionInUrl: true
      }
    });

    showGate("Checking saved Admin login…");
    // Avoid a page hanging forever if the browser's auth storage/lock is stuck.
    const result = await Promise.race([
      db.auth.getSession(),
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("Admin session check timed out. Please close duplicate DS FOREVER tabs and reopen Admin Dashboard.")), 10000)
      )
    ]);
    if (result.error) throw result.error;
    const user = result.data?.session?.user;
    if (!user) {
      throw new Error("Admin session nahi mila. Admin Dashboard mein login karke Points Management dobara kholein.");
    }
    showGate("Admin session found. Verifying permissions…");
    await verifyAdmin(user);
    showApp();
  }

  $("searchBtn").onclick = async () => {
    $("searchResults").textContent = "Searching…";
    $("status").textContent = "";
    try {
      const q = $("userSearch").value.trim();
      if (q.length < 2) throw new Error("Kam se kam 2 characters type karein.");
      const { data, error } = await db.from("profiles")
        .select("id,full_name,email")
        .or(`full_name.ilike.%${q}%,email.ilike.%${q}%`)
        .limit(20);
      if (error) throw error;
      $("searchResults").innerHTML = (data || []).map(u =>
        `<div class="entry"><strong>${esc(u.full_name || "User")}</strong>
        <div class="muted">${esc(u.email)}<br>${esc(u.id)}</div>
        <button data-user="${esc(u.id)}">Select user</button></div>`
      ).join("") || "No users found.";
      $("searchResults").querySelectorAll("button[data-user]").forEach(btn => {
        btn.onclick = () => selectUser((data || []).find(u => u.id === btn.dataset.user));
      });
    } catch (err) {
      $("searchResults").textContent = err.message || String(err);
    }
  };

  async function selectUser(user) {
    if (!user) return;
    selected = user;
    $("selectedUser").classList.remove("hidden");
    $("userHeading").textContent = (user.full_name || user.email || "User") + " • " + user.id;
    await loadLedger();
  }

  async function loadLedger() {
    const { data, error } = await db.from("ds_coin_ledger")
      .select("id,action,amount,reason,created_at")
      .eq("user_id", selected.id)
      .order("created_at", { ascending: false })
      .limit(50);
    if (error) {
      $("userLedger").textContent = "Ledger load error: " + error.message;
      return;
    }
    const rows = data || [];
    const balance = rows.reduce((sum, row) =>
      sum + (row.action === "add" ? Number(row.amount) : -Number(row.amount)), 0);
    $("userLedger").innerHTML =
      `<h3>Current points: ${balance.toLocaleString()}</h3>` +
      (rows.map(row =>
        `<div class="entry">${row.action === "add" ? "+" : "−"}${Number(row.amount).toLocaleString()} points — ${esc(row.reason)}
        <div class="muted">${new Date(row.created_at).toLocaleString()}</div></div>`
      ).join("") || "<p>No history yet.</p>");
  }

  $("applyBtn").onclick = async () => {
    $("applyBtn").disabled = true;
    try {
      if (!selected) throw new Error("Select a user first.");
      const amount = Number($("amount").value);
      const action = $("action").value;
      const reason = $("reason").value.trim();
      if (!Number.isSafeInteger(amount) || amount < 1) throw new Error("Enter a whole number greater than zero.");
      if (reason.length < 3) throw new Error("Enter a reason (at least 3 characters).");
      const { error } = await db.rpc("ds_admin_adjust_points", {
        p_user_id: selected.id,
        p_action: action,
        p_amount: amount,
        p_reason: reason
      });
      if (error) throw error;
      $("status").textContent = "Points adjustment saved.";
      $("amount").value = "";
      $("reason").value = "";
      await loadLedger();
    } catch (err) {
      $("status").textContent = "ERROR: " + (err.message || String(err));
    } finally {
      $("applyBtn").disabled = false;
    }
  };

  $("backBtn").onclick = () => location.href = "admin.html";
  $("logoutBtn").onclick = async () => {
    try { if (db) await db.auth.signOut(); } finally { location.href = "admin.html"; }
  };

  initialize().catch(err => fail(err.message || String(err)));
})();
</script>
</body>
</html>
